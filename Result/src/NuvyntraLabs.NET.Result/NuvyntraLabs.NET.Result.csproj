<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NuvyntraLabs.NET.Result</RootNamespace>
    <AssemblyName>NuvyntraLabs.NET.Result</AssemblyName>
    <PackageId>NuvyntraLabs.NET.Result</PackageId>
    <Title>NuvyntraLabs.NET.Result</Title>
    <Description>Return a success value or a typed error without throwing.</Description>
    <PackageTags>nuvyntra;result;errors</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nuvyntralabs/NuvyntraLabs.NET.Result</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/NuvyntraLabs.NET.Result</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
